# Environment Configuration for Adaptive OS Scheduling Platform

# Server Port and Host
HOST=127.0.0.1
PORT=8000

# Database Connection (defaults to SQLite local database)
# For SQLite: sqlite:///./adaptive_scheduling.db
# For PostgreSQL: postgresql://postgres:password@localhost:5432/adaptive_scheduling
DATABASE_URL=sqlite:///./adaptive_scheduling.db

# Frontend Dev Server Port
VITE_PORT=3000
